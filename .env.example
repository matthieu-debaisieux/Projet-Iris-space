# Copier ce fichier en .env (en production, y mettre un vrai mot de passe)
DB_USER=iris
# Même valeur que l'ancien docker-compose.yml (« iris ») : un volume db_data créé avant
# garde ce mot de passe, PostgreSQL ne le relit qu'à la création du volume.
# Si l'API répond 500 « password authentication failed » : mettre ici le mot de passe
# du volume, ou le recréer avec `docker compose down -v` (efface la base locale).
DB_PASSWORD=iris
# Environnement : dev (détail des erreurs, cookie HTTP local) ou production (cookie Secure, erreurs masquées)
APP_ENV=dev
